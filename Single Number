#include<bits/stdc++.h>
using namespace std;
int find(vector<int>&nums)
{
    int n=nums.size();
    int a=0;
    for(int i=0;i<n;i++)
    {
        a=a^nums[i];
    }
    return a;
}
int main()
{
    int n;
    cout<<"enter the range of the array";
    cin>>n;
    vector<int>nums(n);
    cout<<"enter the elements of the array";
    for(int i=0;i<n;i++)
    {
        cin>>nums[i];
    }
    int unique=find(nums);
    cout<<"unique="<<unique;
}
