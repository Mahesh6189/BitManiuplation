#include<bits/stdc++.h>
using namespace std;
int find(vector<int>&nums)
{
    int ans=0;
    int n=nums.size();
   for(int index=0;index<32;index++)
   {
       int cnt=0;
       for(int i=0;i<n;i++)
       {
           if(nums[i]&(1<<index)) cnt++;
       }
       if(cnt%3==1){
           ans=ans|(1<<index);
       }
   }
   return ans;
}
int main()
{
    int n;
    cout<<"enter the range of the array";
    cin>>n;
    vector<int>nums(n);
    cout<<"enter the elements of the array";
    for(int i=0;i<n;i++)
    {
        cin>>nums[i];
    }
    int unique=find(nums);
    cout<<"unique="<<unique;
}
