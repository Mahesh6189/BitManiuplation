#include<iostream>
using namespace std;
int main()
{
    int n,target,res,cnt=0;
    cout<<"enter a number";
    cin>>n;
    cout<<"enter target number";
    cin>>target;
    res=n^target;
    while(res>1)
    {
        cnt+=(res&1);
        res=res>>1;
    }
    if(res==1) cnt+=1;
    cout<<" total numer of flips="<<cnt;
}
